---
// Moldura de iPhone. Por omissão é feita em CSS (aro de titânio, ecrã com
// cantos redondos e Dynamic Island). Com device="iphone15" usa a foto do
// mockup do iPhone 15 Pro (com o ecrã recortado) por cima do ecrã.
// O ecrã vai no slot e enche o espaço.
import { Image } from 'astro:assets';
import iphone15 from '../../assets/devices/iphone15.png';

interface Props {
  class?: string;
  device?: 'css' | 'iphone15';
}
const { class: className, device = 'css' } = Astro.props;
---

{
  device === 'iphone15' ? (
    <div class:list={['iphone15', className]}>
      <div class="iphone__screen iphone15__screen">
        <slot />
      </div>
      <Image class="iphone15__frame" src={iphone15} alt="" widths={[584]} quality={95} format="webp" />
    </div>
  ) : (
    <div class:list={['iphone', className]}>
      <span class="iphone__btn iphone__btn--action" aria-hidden="true" />
      <span class="iphone__btn iphone__btn--up" aria-hidden="true" />
      <span class="iphone__btn iphone__btn--down" aria-hidden="true" />
      <span class="iphone__btn iphone__btn--power" aria-hidden="true" />
      <div class="iphone__screen">
        <slot />
        <span class="iphone__island" aria-hidden="true" />
      </div>
    </div>
  )
}

<style>
  .iphone {
    position: relative;
    width: 100%;
    aspect-ratio: 433 / 892;
    padding: 4.6%;
    border-radius: 15% / 7.2%;
    background:
      linear-gradient(145deg, #5d6470 0%, #2a2e36 18%, #1a1d23 50%, #2a2e36 82%, #6a717d 100%);
    box-shadow:
      inset 0 0 0 1.5px rgb(255 255 255 / 0.18),
      inset 0 0 0 4px #0b0c0f,
      0 2.5rem 4rem -1.5rem rgb(0 0 0 / 0.65),
      0 0.75rem 1.5rem -0.75rem rgb(0 0 0 / 0.5);
  }

  .iphone__screen {
    position: relative;
    height: 100%;
    overflow: hidden;
    border-radius: 12.5% / 5.8%;
    background: #f7fcff;
    isolation: isolate;
  }

  .iphone__screen :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: 0;
    border-radius: 0;
  }

  .iphone__island {
    position: absolute;
    z-index: 2;
    top: 1.6%;
    left: 50%;
    width: 31%;
    height: 3.6%;
    translate: -50% 0;
    border-radius: 999px;
    background: #000;
  }

  .iphone__btn {
    position: absolute;
    width: 0.9%;
    border-radius: 2px;
    background: linear-gradient(90deg, #5d6470, #2a2e36);
  }

  .iphone__btn--action {
    left: -0.6%;
    top: 18%;
    height: 3.5%;
  }

  .iphone__btn--up {
    left: -0.6%;
    top: 25%;
    height: 7%;
  }

  .iphone__btn--down {
    left: -0.6%;
    top: 34%;
    height: 7%;
  }

  .iphone__btn--power {
    right: -0.6%;
    top: 28%;
    height: 11%;
  }

  /* Mockup do iPhone 15 Pro: o ecrã fica no buraco da foto (medidas da foto 584x1176) */
  .iphone15 {
    position: relative;
    width: 100%;
    aspect-ratio: 584 / 1176;
    filter: drop-shadow(0 2rem 2.5rem rgb(0 0 0 / 0.55));
  }

  .iphone15__screen {
    position: absolute;
    left: 5.9%;
    top: 2.47%;
    width: 88.53%;
    height: 95.15%;
    border-radius: 13.2% / 6.1%;
    background: #fff;
  }

  .iphone15 > :global(.iphone15__frame) {
    position: absolute;
    z-index: 5;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    border-radius: 0;
    pointer-events: none;
  }
</style>
