---
// Relatório "desmontado": o iPhone com o relatório ao centro e as partes
// dele a flutuar à volta, com os anéis a encher quando aparecem.
// Usa as cores e letras do próprio projeto (vars --r-*).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import PhoneFrame from './PhoneFrame.astro';

interface Props {
  phone: { src: ImageMetadata; alt: string };
  scores: { label: string; value: number; text: string; tone: 'good' | 'warn' }[];
  actions: { priority: string; text: string }[];
  caption?: string;
  note?: string;
}
const { phone, scores, actions, caption, note } = Astro.props;
const R = 26;
const C = 2 * Math.PI * R;
---

<figure class="report" data-report data-fred-note={note}>
  <div class="report__stage">
    <span class="report__ring-bg" aria-hidden="true"></span>
    <div class="report__phone">
      <PhoneFrame>
        <Image src={phone.src} alt={phone.alt} widths={[393, 786]} quality={92} sizes="18rem" />
      </PhoneFrame>
    </div>

    {
      scores.map((s, i) => (
        <div class:list={['report__card', 'report__score', `is-${s.tone}`]} style={`--i:${i}`}>
          <svg class="report__ring" viewBox="0 0 64 64" aria-hidden="true">
            <circle cx="32" cy="32" r={R} class="report__track" />
            <circle
              cx="32"
              cy="32"
              r={R}
              class="report__fill"
              style={`--c:${C.toFixed(2)};--off:${(C * (1 - s.value / 100)).toFixed(2)}`}
            />
          </svg>
          <span class="report__value" data-value={s.value}>
            {s.value}%
          </span>
          <div>
            <strong>{s.label}</strong>
            <p>{s.text}</p>
          </div>
        </div>
      ))
    }

    {
      actions.map((a, i) => (
        <div class="report__card report__action" style={`--i:${scores.length + i}`}>
          <span class="report__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24">
              <path d="M3 12h4l2.5-6 5 12 2.5-6h4" />
            </svg>
          </span>
          <div>
            <span class="report__priority">{a.priority}</span>
            <p>{a.text}</p>
          </div>
        </div>
      ))
    }
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
  // Quando o relatório aparece, os cartões saem do telemóvel e os números contam
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-report]').forEach((root) => {
    const values = [...root.querySelectorAll<HTMLElement>('[data-value]')];
    const start = () => {
      root.classList.add('is-in');
      if (reduced) return;
      values.forEach((el, k) => {
        const target = Number(el.dataset.value);
        const t0 = performance.now() + 350 + k * 120;
        const tick = (now: number) => {
          const p = Math.min(1, Math.max(0, (now - t0) / 1300));
          el.textContent = `${Math.round(target * (1 - (1 - p) ** 3))}%`;
          if (p < 1) requestAnimationFrame(tick);
        };
        el.textContent = '0%';
        requestAnimationFrame(tick);
      });
    };
    if (!('IntersectionObserver' in window)) return start();
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) return;
        observer.disconnect();
        start();
      },
      { threshold: 0.35 },
    );
    observer.observe(root);
  });
</script>

<style>
  .report {
    margin: 0;
    display: grid;
    gap: var(--space-4);
    --r-navy: #1a3f55;
    --r-ocean: #2e7eb3;
    --r-sage: #98c788;
    --r-honey: #e4ac51;
  }

  .report figcaption {
    max-width: 60ch;
    margin-inline: auto;
    text-align: center;
    color: var(--color-text-2);
  }

  .report__stage {
    position: relative;
    display: grid;
    gap: var(--space-4);
    padding: var(--space-8) var(--space-4);
    border-radius: var(--radius-card);
    background: radial-gradient(120% 90% at 50% 0%, #f7fcff 0%, #dcedf8 55%, #aad2ec 100%);
    overflow: hidden;
    font-family: 'Nunito', system-ui, sans-serif;
    color: var(--r-navy);
  }

  .report__ring-bg {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 46rem;
    aspect-ratio: 1;
    translate: -50% -50%;
    border-radius: 50%;
    background: repeating-radial-gradient(circle, transparent 0 5.5rem, rgb(255 255 255 / 0.55) 5.5rem 5.6rem);
    pointer-events: none;
  }

  .report__phone {
    position: relative;
    width: min(16rem, 64%);
    justify-self: center;
    margin-bottom: var(--space-4);
  }

  .report__card {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-4);
    align-items: center;
    padding: var(--space-4) var(--space-6) var(--space-4) var(--space-4);
    border-radius: 20px;
    background: rgb(255 255 255 / 0.92);
    box-shadow:
      0 1.25rem 2.5rem -1rem rgb(26 63 85 / 0.28),
      0 0 0 1px rgb(26 63 85 / 0.06);
  }

  .report__card strong {
    font-family: 'Quicksand', system-ui, sans-serif;
    font-weight: 700;
    font-size: 1.05rem;
  }

  .report__card p {
    margin-top: 0.15rem;
    font-size: 0.9rem;
    line-height: 1.4;
    color: #4a6577;
  }

  /* Anel com a pontuação */
  .report__score {
    grid-template-columns: 4rem 1fr;
  }

  .report__ring {
    grid-area: 1 / 1;
    width: 4rem;
    rotate: -90deg;
  }

  .report__value {
    grid-area: 1 / 1;
    justify-self: center;
    font-family: 'Quicksand', system-ui, sans-serif;
    font-weight: 700;
    font-size: 1rem;
    font-variant-numeric: tabular-nums;
  }

  .report__track,
  .report__fill {
    fill: none;
    stroke-width: 6;
  }

  .report__track {
    stroke: rgb(26 63 85 / 0.08);
  }

  .report__fill {
    stroke: var(--tone);
    stroke-linecap: round;
    stroke-dasharray: var(--c);
    stroke-dashoffset: var(--c);
    transition: stroke-dashoffset 1.3s cubic-bezier(0.2, 0.8, 0.2, 1) calc(0.35s + var(--i) * 0.12s);
  }

  .is-in .report__fill {
    stroke-dashoffset: var(--off);
  }

  .is-good {
    --tone: var(--r-sage);
  }

  .is-warn {
    --tone: var(--r-honey);
  }

  .report__icon {
    display: grid;
    place-items: center;
    width: 2.5rem;
    aspect-ratio: 1;
    border-radius: 10px;
    background: #fdf0d9;
  }

  .report__icon svg {
    width: 1.25rem;
    fill: none;
    stroke: var(--r-honey);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .report__priority {
    font-size: 0.85rem;
    color: #c98e2c;
  }

  .report__action p {
    color: var(--r-navy);
  }

  /* Computador: os cartões flutuam à volta do telemóvel */
  @media (min-width: 56rem) {
    .report__stage {
      display: block;
      height: 44rem;
      padding: 0;
    }

    .report__phone {
      position: absolute;
      left: 50%;
      top: 50%;
      width: 17rem;
      margin: 0;
      translate: -50% -50%;
    }

    .report__card {
      position: absolute;
      width: 19rem;
      opacity: 0;
      translate: var(--from-x) 0;
      scale: 0.9;
      transition:
        opacity 0.6s ease calc(var(--i) * 0.12s),
        translate 0.9s cubic-bezier(0.2, 0.8, 0.2, 1) calc(var(--i) * 0.12s),
        scale 0.9s cubic-bezier(0.2, 0.8, 0.2, 1) calc(var(--i) * 0.12s);
    }

    .is-in .report__card {
      opacity: 1;
      translate: 0 0;
      scale: 1;
    }

    /* posições: três anéis + duas ações à volta do telemóvel */
    .report__card:nth-of-type(2) {
      left: 6%;
      top: 13%;
      rotate: -3deg;
      --from-x: 9rem;
    }

    .report__card:nth-of-type(3) {
      left: 3%;
      top: 44%;
      rotate: 2deg;
      --from-x: 11rem;
    }

    .report__card:nth-of-type(4) {
      left: 8%;
      top: 73%;
      rotate: -1.5deg;
      --from-x: 9rem;
    }

    .report__card:nth-of-type(5) {
      right: 5%;
      top: 22%;
      rotate: 2.5deg;
      --from-x: -9rem;
    }

    .report__card:nth-of-type(6) {
      right: 7%;
      top: 56%;
      rotate: -2deg;
      --from-x: -10rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .report__card,
    .report__fill {
      transition: none;
    }
  }
</style>
