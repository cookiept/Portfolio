---
import { site } from '@data/site';

// Repetido para o loop ficar contínuo
const items = [...site.skills, ...site.skills];
---

<div class="marquee mono" aria-hidden="true">
  <div class="marquee__track">
    {
      [0, 1].map(() => (
        <ul class="marquee__group">
          {items.map((s) => (
            <li>
              {s}
              <span class="marquee__star">✦</span>
            </li>
          ))}
        </ul>
      ))
    }
  </div>
</div>

<style>
  .marquee {
    overflow: hidden;
    border-block: 1px solid var(--color-line);
    color: var(--color-text-2);
    padding-block: var(--space-18);
    background: var(--color-bg);
  }

  .marquee__track {
    display: flex;
    width: max-content;
    animation: scroll 40s linear infinite;
  }

  .marquee:hover .marquee__track {
    animation-play-state: paused;
  }

  .marquee__group {
    display: flex;
    gap: var(--space-24);
    margin: 0;
    padding: 0 var(--space-24) 0 0;
    list-style: none;
  }

  .marquee__group li {
    display: flex;
    align-items: center;
    gap: var(--space-24);
    white-space: nowrap;
  }

  .marquee__star {
    color: var(--color-accent);
  }

  @keyframes scroll {
    to {
      transform: translateX(-50%);
    }
  }
</style>
