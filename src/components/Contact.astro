---
import { site } from '@data/site';
import { withBase } from '../utils/url';

const { instagram, email, cv } = site.links;

const rows = [
  { label: instagram.label, value: instagram.handle, href: instagram.url, external: true },
  { label: 'Email', value: email ?? 'Coming soon', href: email ? `mailto:${email}` : null, external: false },
  { label: 'Résumé', value: cv ? 'Download PDF' : 'Coming soon', href: cv ? withBase('/cv.pdf') : null, external: false },
];
---

<section id="contact" class="contact" aria-labelledby="contact-title">
  <div class="container">
    <p class="contact__kicker mono" data-reveal><span class="dot dot--pulse"></span> Open to freelance & full-time roles</p>
    <h2 id="contact-title" class="contact__title" data-reveal>Let’s talk</h2>

    <ul class="contact__list">
      {
        rows.map((row, i) => (
          <li data-reveal style={`--reveal-delay:${i * 0.08}s`}>
            {row.href ? (
              <a
                class="contact__row"
                href={row.href}
                {...(row.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                {...(row.label === 'Résumé' ? { download: '' } : {})}
              >
                <span class="mono">{row.label}</span>
                <span class="contact__value">{row.value}</span>
                <span class="contact__arrow" aria-hidden="true">↗</span>
              </a>
            ) : (
              <div class="contact__row contact__row--soon">
                <span class="mono">{row.label}</span>
                <span class="contact__value">{row.value}</span>
                <span class="contact__arrow" aria-hidden="true">…</span>
              </div>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .contact {
    padding-block: var(--space-120) var(--space-72);
    border-top: 1px solid var(--color-line);
    background: var(--color-surface);
  }

  .contact__kicker {
    display: flex;
    align-items: center;
    gap: var(--space-12);
    color: var(--color-text-2);
    margin-bottom: var(--space-24);
  }

  .contact__title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--text-display);
    line-height: var(--leading-tight);
    text-transform: uppercase;
    background: var(--gradient-display);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    margin-bottom: var(--space-72);
  }

  .contact__list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-line);
  }

  .contact__row {
    position: relative;
    display: grid;
    grid-template-columns: 8rem 1fr auto;
    align-items: center;
    gap: var(--space-24);
    padding: var(--space-24) var(--space-12);
    border-bottom: 1px solid var(--color-line);
    isolation: isolate;
    overflow: hidden;
    transition: color var(--dur-component) var(--ease-out);
  }

  .contact__row .mono {
    color: var(--color-muted);
    transition: color var(--dur-component) var(--ease-out);
  }

  .contact__value {
    font-size: var(--text-heading);
    line-height: 1;
    letter-spacing: var(--tracking-heading);
  }

  .contact__arrow {
    font-size: var(--text-heading-sm);
    transition: transform var(--dur-component) var(--ease-out);
  }

  /* Preenchimento que sobe por trás da linha */
  a.contact__row::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--color-text);
    transform: scaleY(0);
    transform-origin: 50% 100%;
    transition: transform var(--dur-component) var(--ease-expo);
  }

  a.contact__row:hover {
    color: var(--color-bg);
  }

  a.contact__row:hover .mono {
    color: var(--color-bg);
  }

  a.contact__row:hover::before {
    transform: scaleY(1);
  }

  a.contact__row:hover .contact__arrow {
    transform: rotate(45deg);
  }

  .contact__row--soon .contact__value,
  .contact__row--soon .contact__arrow {
    color: var(--color-muted);
  }

  @media (max-width: 40rem) {
    .contact__row {
      grid-template-columns: 1fr auto;
    }

    .contact__row .mono {
      grid-column: 1 / -1;
    }

    .contact__value {
      font-size: var(--text-heading-sm);
    }
  }
</style>
