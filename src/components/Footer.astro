---
import { site } from '@data/site';
const year = new Date().getFullYear();
---

<footer class="footer container mono">
  <span>© {year} {site.name}</span>
  <span>Lisbon <time class="footer__clock">--:--</time></span>
  <a href="#top" class="footer__top">Back to top ↑</a>
</footer>

<style>
  .footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-12);
    padding-block: var(--space-24);
    color: var(--color-muted);
    font-size: var(--text-micro);
  }

  .footer__top:hover {
    color: var(--color-text);
  }
</style>

<script>
  // Hora local em Lisboa
  const clock = document.querySelector<HTMLTimeElement>('.footer__clock');
  if (clock) {
    const fmt = new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Lisbon', hour: '2-digit', minute: '2-digit' });
    const update = () => (clock.textContent = fmt.format(new Date()));
    update();
    setInterval(update, 30_000);
  }
</script>
