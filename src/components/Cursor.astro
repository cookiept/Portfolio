---
// Cursor personalizado: um ponto que segue o rato e cresce com uma etiqueta
// sobre elementos com [data-cursor="Texto"]. Só em dispositivos com rato.
---

<div class="cursor" aria-hidden="true">
  <span class="cursor__label"></span>
</div>

<style>
  .cursor {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 100;
    width: 0.75rem;
    height: 0.75rem;
    margin: -0.375rem 0 0 -0.375rem;
    border-radius: 50%;
    background: var(--color-text);
    pointer-events: none;
    mix-blend-mode: difference;
    opacity: 0;
    display: grid;
    place-items: center;
    transition:
      width var(--dur-component) var(--ease-out),
      height var(--dur-component) var(--ease-out),
      margin var(--dur-component) var(--ease-out),
      opacity var(--dur-micro) var(--ease-out),
      background-color var(--dur-micro) var(--ease-out);
  }

  .cursor.is-active {
    opacity: 1;
  }

  .cursor.has-label {
    width: 5.5rem;
    height: 5.5rem;
    margin: -2.75rem 0 0 -2.75rem;
    background: var(--color-accent);
    mix-blend-mode: normal;
  }

  .cursor__label {
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    font-weight: 600;
    text-transform: uppercase;
    color: var(--color-bg);
    opacity: 0;
    transform: scale(0.6);
    transition:
      opacity var(--dur-micro) var(--ease-out),
      transform var(--dur-component) var(--ease-out);
  }

  .cursor.has-label .cursor__label {
    opacity: 1;
    transform: none;
  }

  @media (hover: none), (pointer: coarse) {
    .cursor {
      display: none;
    }
  }
</style>

<script>
  const cursor = document.querySelector<HTMLElement>('.cursor');
  const label = cursor?.querySelector<HTMLElement>('.cursor__label');
  const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (cursor && label && finePointer) {
    let x = 0;
    let y = 0;
    let cx = 0;
    let cy = 0;

    window.addEventListener('pointermove', (e) => {
      x = e.clientX;
      y = e.clientY;
      cursor.classList.add('is-active');

      const target = (e.target as Element).closest<HTMLElement>('[data-cursor]');
      if (target) {
        label.textContent = target.dataset.cursor ?? '';
        cursor.classList.add('has-label');
      } else {
        cursor.classList.remove('has-label');
      }
    });

    document.addEventListener('pointerleave', () => cursor.classList.remove('is-active'));

    const tick = () => {
      const k = reduced ? 1 : 0.2;
      cx += (x - cx) * k;
      cy += (y - cy) * k;
      cursor.style.transform = `translate3d(${cx}px, ${cy}px, 0)`;
      requestAnimationFrame(tick);
    };
    tick();
  }
</script>
