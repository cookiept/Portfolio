---
import { site } from '@data/site';

const letters = [...site.name.toUpperCase()];
---

<section class="hero">
  <div class="hero__inner container">
    <h1 class="hero__title" aria-label={site.name}>
      <span class="hero__line" aria-hidden="true">
        {
          letters.map((l, i) => (
            <span class="hero__letter" style={`--i:${i}`}>
              {l}
            </span>
          ))
        }
      </span>
    </h1>

    <div class="hero__meta">
      <p class="hero__intro">{site.intro}</p>
      <ul class="hero__facts mono">
        <li>({site.role})</li>
        <li>{site.location}</li>
        <li><a href="#work" class="hero__scroll">Scroll <span aria-hidden="true">↓</span></a></li>
      </ul>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    padding-block: var(--space-120) var(--space-48);
    background:
      radial-gradient(60% 50% at 50% 0%, rgb(255 255 255 / 0.06), transparent 70%),
      var(--color-surface);
    overflow: hidden;
  }

  .hero__inner {
    display: grid;
    gap: var(--space-48);
  }

  .hero__title {
    font-family: var(--font-display);
    font-weight: 400;
    /* tamanho calculado para o nome ocupar a largura toda */
    font-size: min(27.5vw, 62svh);
    line-height: var(--leading-tight);
    letter-spacing: -0.015em;
    text-transform: uppercase;
    margin-bottom: 0.24em; /* espaço para a cedilha */
  }

  .hero__line {
    display: flex;
    justify-content: center;
  }

  .hero__letter {
    display: inline-block;
    /* o gradiente só pinta dentro da caixa: alargar para cobrir topo e cedilha */
    padding-block: 0.1em 0.4em;
    margin-block: -0.1em -0.4em;
    background: var(--gradient-display);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    transform-origin: 50% 100%;
    transform: translateY(var(--lift, 0)) scaleY(var(--stretch, 1));
    transition: transform var(--dur-component) var(--ease-out);
    will-change: transform;
  }

  .js .hero__letter {
    animation: rise 1.1s var(--ease-expo) both;
    animation-delay: calc(0.15s + var(--i) * 0.07s);
  }

  @keyframes rise {
    from {
      opacity: 0;
      filter: blur(12px);
      transform: translateY(35%) scaleY(1.4);
    }
  }

  .hero__meta {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: var(--space-24);
    padding-top: var(--space-18);
    border-top: 1px solid var(--color-line);
  }

  .hero__intro {
    max-width: 30ch;
    font-size: var(--text-heading-sm);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-heading);
    color: var(--color-text);
  }

  .hero__facts {
    display: grid;
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
    text-align: right;
    color: var(--color-text-2);
  }

  .hero__scroll {
    color: var(--color-text);
  }

  .hero__scroll span {
    display: inline-block;
    animation: nudge 1.8s var(--ease-out) infinite;
  }

  @keyframes nudge {
    50% {
      transform: translateY(0.25em);
    }
  }

  .js .hero__meta {
    animation: fade-up var(--dur-page) var(--ease-out) both 0.8s;
  }

  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(1.5rem);
    }
  }

  @media (max-width: 40rem) {
    .hero__meta {
      grid-template-columns: 1fr;
    }

    .hero__facts {
      text-align: left;
    }
  }
</style>

<script>
  // As letras esticam e sobem quando o rato passa perto delas.
  const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const title = document.querySelector<HTMLElement>('.hero__title');
  const letters = [...document.querySelectorAll<HTMLElement>('.hero__letter')];

  if (title && finePointer && !reduced) {
    const hero = title.closest<HTMLElement>('.hero')!;

    // Só ativa depois da animação de entrada terminar
    setTimeout(() => {
      letters.forEach((l) => (l.style.animation = 'none'));

      hero.addEventListener('pointermove', (e) => {
        for (const letter of letters) {
          const r = letter.getBoundingClientRect();
          const dx = e.clientX - (r.left + r.width / 2);
          const dy = e.clientY - (r.top + r.height / 2);
          const dist = Math.hypot(dx, dy * 0.6);
          const force = Math.max(0, 1 - dist / (r.width * 2.2));
          letter.style.setProperty('--stretch', String(1 + force * 0.18));
          letter.style.setProperty('--lift', `${-force * 2}%`);
        }
      });

      hero.addEventListener('pointerleave', () => {
        letters.forEach((l) => {
          l.style.setProperty('--stretch', '1');
          l.style.setProperty('--lift', '0');
        });
      });
    }, 1800);
  }
</script>
