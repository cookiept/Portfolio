---
import SpecularButton from '@components/effects/Specular/SpecularButton.jsx';
import { site } from '@data/site';
import { withBase } from '../../utils/url';

const { instagram, linkedin, cv } = site.links;
---

<section id="contact" class="contact container" aria-labelledby="contact-title" data-buddy-zone="contact">
  <h2 id="contact-title" class="contact__title" data-reveal>
    Like what you see? <span class="accent">Say hi.</span>
  </h2>

  <div class="contact__layout">
    <form class="contact__form" action={site.contactForm} method="POST" data-contact-form data-reveal style="--reveal-delay:0.12s">
      <input type="hidden" name="_subject" value="New message from your portfolio" />
      <input type="hidden" name="_template" value="table" />
      <input type="text" name="_honey" class="contact__honey" tabindex="-1" autocomplete="off" aria-hidden="true" />

      <div class="contact__row">
        <label class="contact__field">
          <span>Name</span>
          <input type="text" name="name" autocomplete="name" required maxlength="120" />
        </label>
        <label class="contact__field">
          <span>Email</span>
          <input type="email" name="email" autocomplete="email" required maxlength="200" />
        </label>
      </div>
      <label class="contact__field">
        <span>Message</span>
        <textarea name="message" rows="5" required maxlength="5000" placeholder="Tell me about your project, role or idea."></textarea>
      </label>

      <div class="contact__submit">
        <SpecularButton client:visible type="submit" size="lg" radius={999} lineColor="#a9c8ff" baseColor="#4a5468">
          Send message
        </SpecularButton>
        <p class="contact__status" data-contact-status role="status" aria-live="polite"></p>
      </div>
    </form>

    <div class="contact__aside" data-reveal style="--reveal-delay:0.24s">
      <p class="contact__lede">Rather chat somewhere else?</p>
      <a class="contact__link" href={instagram.url} target="_blank" rel="noopener noreferrer">
        Instagram <span>{instagram.handle} ↗</span>
      </a>
      <a class="contact__link" href={linkedin.url} target="_blank" rel="noopener noreferrer">
        LinkedIn <span>{linkedin.handle} ↗</span>
      </a>
      <p class="contact__link">
        Résumé
        {cv ? <a href={withBase('/cv.pdf')} download>download PDF</a> : <span>coming soon</span>}
      </p>
    </div>
  </div>
</section>

<script>
  import '../../scripts/contact-form';
</script>

<style>
  .contact {
    display: grid;
    gap: var(--space-12);
    padding-block: var(--space-24);
    border-top: 1px solid var(--color-line);
  }

  .contact__title {
    max-width: 16ch;
    font-size: var(--text-h2);
  }

  .contact__layout {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    gap: var(--space-12);
    align-items: start;
  }

  .contact__form {
    display: grid;
    gap: var(--space-6);
  }

  .contact__row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-6);
  }

  .contact__field {
    display: grid;
    gap: var(--space-2);
    color: var(--color-text-2);
    font-size: var(--text-sm);
  }

  .contact__field input,
  .contact__field textarea {
    width: 100%;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-line-strong);
    border-radius: 14px;
    background: var(--color-surface);
    color: var(--color-text);
    font: inherit;
    font-size: var(--text-base);
    transition: border-color var(--dur-fast) var(--ease-out);
  }

  .contact__field textarea {
    resize: vertical;
    min-height: 8rem;
  }

  .contact__field input:focus,
  .contact__field textarea:focus {
    outline: none;
    border-color: var(--color-accent);
  }

  .contact__field ::placeholder {
    color: var(--color-muted);
  }

  /* Armadilha para bots: fora do ecrã */
  .contact__honey {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .contact__submit {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-6);
  }

  .contact__status {
    margin: 0;
    color: var(--color-text-2);
    font-size: var(--text-sm);
  }

  .contact__status[data-state='sent'] {
    color: var(--color-accent);
  }

  .contact__status[data-state='error'] {
    color: #ffb4b4;
  }

  .contact__aside {
    display: grid;
    gap: var(--space-3);
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .contact__lede {
    margin: 0 0 var(--space-2);
    color: var(--color-text-2);
    font-size: var(--text-base);
  }

  .contact__link {
    margin: 0;
    color: var(--color-muted);
    text-decoration: none;
  }

  .contact__link span,
  .contact__link a {
    margin-left: var(--space-2);
    color: var(--color-text-2);
  }

  a.contact__link:hover span,
  .contact__link a:hover {
    color: var(--color-text);
  }

  @media (max-width: 50rem) {
    .contact__layout,
    .contact__row {
      grid-template-columns: 1fr;
    }
  }
</style>
