---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../utils/url';

interface Props {
  project: CollectionEntry<'projects'>;
  index: number;
}

const { project, index } = Astro.props;
const { title, type, year, tagline, shape, placeholder, tags } = project.data;
const number = String(index + 1).padStart(2, '0');
const Tag = placeholder ? 'div' : 'a';
const linkProps = placeholder
  ? { 'data-cursor': 'Soon' }
  : { href: withBase(`/projects/${project.id}/`), 'data-cursor': 'View' };
---

<article class:list={['card', `card--${shape}`, { 'card--placeholder': placeholder }]} data-reveal style={`--reveal-delay:${(index % 3) * 0.12}s`}>
  <Tag class="card__link" {...linkProps}>
    <div class="card__shape">
      <span class="card__name" aria-hidden="true">{title}</span>
      <span class="card__spot" aria-hidden="true"></span>
      <span class="card__index mono">{number}</span>
      {
        tags.length > 0 && (
          <ul class="card__tags mono">
            {tags.map((t) => (
              <li>{t}</li>
            ))}
          </ul>
        )
      }
    </div>
    <div class="card__info">
      <div class="card__row">
        <h3 class="card__title">{title}</h3>
        <span class="card__arrow" aria-hidden="true">{placeholder ? '…' : '↗'}</span>
      </div>
      <p class="card__meta mono">{type} — {year}</p>
      <p class="card__tagline">{tagline}</p>
    </div>
  </Tag>
</article>

<style>
  .card__link {
    display: grid;
    gap: var(--space-18);
    cursor: pointer;
  }

  .card--placeholder .card__link {
    cursor: default;
  }

  /* A forma: cada projeto tem uma silhueta diferente que se transforma no hover */
  .card__shape {
    --r: 6% / 5%;
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--shape);
    background:
      linear-gradient(160deg, var(--color-surface-3), var(--color-surface) 70%),
      var(--color-surface);
    border: 1px solid var(--color-line);
    isolation: isolate;
    transition:
      border-radius var(--dur-page) var(--ease-expo),
      transform var(--dur-page) var(--ease-expo),
      border-color var(--dur-micro) var(--ease-out);
  }

  .card--arch {
    --shape: 50% 50% 4% 4% / 32% 32% 3% 3%;
  }
  .card--capsule {
    --shape: 50% / 32%;
  }
  .card--oval {
    --shape: 50% / 50%;
  }
  .card--leaf {
    --shape: 50% 4% 50% 4% / 40% 3% 40% 3%;
  }
  .card--drop {
    --shape: 50% 50% 50% 4% / 40% 40% 40% 3%;
  }
  .card--tilt {
    --shape: 4% 50% 4% 50% / 3% 40% 3% 40%;
  }

  .card__link:hover .card__shape,
  .card__link:focus-visible .card__shape {
    border-radius: var(--r);
    transform: scale(0.97);
    border-color: var(--color-line-strong);
  }

  /* Nome do projeto em grande dentro da forma */
  .card__name {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 18%;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 1rem + 3.4vw, 4.75rem);
    line-height: 0.86;
    text-align: center;
    text-transform: uppercase;
    background: var(--gradient-display);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    z-index: -1;
    transition: transform var(--dur-page) var(--ease-expo);
  }

  .card__link:hover .card__name {
    transform: scale(1.06) rotate(-3deg);
  }

  .card--placeholder .card__name {
    background: none;
    color: transparent;
    -webkit-text-stroke: 1px var(--color-line-strong);
  }

  /* Luz que segue o rato */
  .card__spot {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      40% 35% at var(--mx, 50%) var(--my, 30%),
      rgb(255 255 255 / 0.14),
      transparent 70%
    );
    opacity: 0;
    transition: opacity var(--dur-component) var(--ease-out);
    z-index: -1;
  }

  .card__link:hover .card__spot {
    opacity: 1;
  }

  .card__index {
    position: absolute;
    top: 14%;
    left: 50%;
    translate: -50% 0;
    color: var(--color-text-2);
    transition: color var(--dur-micro) var(--ease-out);
  }

  .card__link:hover .card__index {
    color: var(--color-accent);
  }

  .card__tags {
    position: absolute;
    left: 50%;
    bottom: 12%;
    translate: -50% 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-6);
    width: 80%;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-micro);
  }

  .card__tags li {
    padding: 0.15rem 0.4rem;
    background: rgb(255 255 255 / 0.05);
    border: 1px solid rgb(255 255 255 / 0.15);
    color: rgb(255 255 255 / 0.7);
    opacity: 0;
    transform: translateY(0.5rem);
    transition:
      opacity var(--dur-component) var(--ease-out),
      transform var(--dur-component) var(--ease-out);
  }

  .card__link:hover .card__tags li {
    opacity: 1;
    transform: none;
  }

  .card__link:hover .card__tags li:nth-child(2) {
    transition-delay: 0.05s;
  }
  .card__link:hover .card__tags li:nth-child(3) {
    transition-delay: 0.1s;
  }

  .card__info {
    display: grid;
    gap: var(--space-6);
  }

  .card__row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-12);
  }

  .card__title {
    font-size: var(--text-heading-sm);
    font-weight: 500;
    line-height: 1;
    letter-spacing: var(--tracking-heading);
  }

  .card__arrow {
    font-size: var(--text-heading-sm);
    line-height: 1;
    transition: transform var(--dur-component) var(--ease-out);
  }

  .card__link:hover .card__arrow {
    transform: translate(0.15em, -0.15em) rotate(45deg);
  }

  .card__meta {
    color: var(--color-muted);
    font-size: var(--text-micro);
  }

  .card__tagline {
    max-width: 38ch;
    font-size: var(--text-body-sm);
    color: var(--color-text-2);
  }

  .card--placeholder .card__shape {
    background: transparent;
    border-style: dashed;
  }

  .card--placeholder .card__title,
  .card--placeholder .card__arrow {
    color: var(--color-muted);
  }

  /* Ecrãs táteis: mostrar logo as tags */
  @media (hover: none) {
    .card__tags li {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.card__shape').forEach((shape) => {
    shape.addEventListener('pointermove', (e) => {
      const r = shape.getBoundingClientRect();
      shape.style.setProperty('--mx', `${((e.clientX - r.left) / r.width) * 100}%`);
      shape.style.setProperty('--my', `${((e.clientY - r.top) / r.height) * 100}%`);
    });
  });
</script>
