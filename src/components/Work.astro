---
import { getCollection } from 'astro:content';
import ProjectCard from './ProjectCard.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const count = String(projects.length).padStart(2, '0');
---

<section id="work" class="work container" aria-labelledby="work-title">
  <header class="work__head" data-reveal>
    <h2 id="work-title" class="work__title">Selected work</h2>
    <p class="work__count mono">({count})</p>
    <p class="work__lede">Products, apps and websites — from early concept to clickable prototype.</p>
  </header>

  <div class="work__grid">
    {projects.map((project, index) => <ProjectCard project={project} index={index} />)}
  </div>
</section>

<style>
  .work {
    padding-block: var(--space-120);
  }

  .work__head {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: var(--space-18) var(--space-24);
    margin-bottom: var(--space-96);
  }

  .work__title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--text-heading-lg);
    line-height: var(--leading-tight);
    text-transform: uppercase;
    background: var(--gradient-display);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .work__count {
    color: var(--color-accent);
  }

  .work__lede {
    grid-column: 1 / -1;
    max-width: 40ch;
    color: var(--color-text-2);
  }

  .work__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-72) var(--space-24);
  }

  /* Coluna do meio desce: ritmo desalinhado, menos "grelha de quadrados" */
  .work__grid > :global(:nth-child(3n + 2)) {
    margin-top: var(--space-120);
  }

  @media (max-width: 60rem) {
    .work__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .work__grid > :global(:nth-child(3n + 2)) {
      margin-top: 0;
    }

    .work__grid > :global(:nth-child(2n)) {
      margin-top: var(--space-96);
    }
  }

  @media (max-width: 36rem) {
    .work__grid {
      grid-template-columns: 1fr;
      gap: var(--space-72);
    }

    .work__grid > :global(:nth-child(2n)) {
      margin-top: 0;
    }
  }
</style>
