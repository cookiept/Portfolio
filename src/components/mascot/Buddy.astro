---
// Buddy: a mascote do site. Vive no fundo do ecrã: passeia de um lado
// para o outro, entretém-se sozinho, segue o rato com os olhos, reage aos
// projetos e ao contacto e mete-se com o visitante de vez em quando.
// A lógica está em src/scripts/buddy.ts.
---

<div class="buddy" data-buddy-root>
  <div class="buddy__stage">
  <p class="buddy__bubble" aria-hidden="true"></p>
  <button class="buddy__btn" type="button" aria-label="Buddy, the site mascot. Click to say hi.">
    <svg class="buddy__svg" viewBox="0 0 100 100" aria-hidden="true">
      <defs>
        <!-- Volume: luz de cima à esquerda, sombra em baixo à direita -->
        <radialGradient id="buddy-body" cx="36%" cy="26%" r="78%">
          <stop offset="0" stop-color="#eef5ff"></stop>
          <stop offset="0.35" stop-color="#b9d3ff"></stop>
          <stop offset="0.75" stop-color="#86a9ec"></stop>
          <stop offset="1" stop-color="#5b7fc4"></stop>
        </radialGradient>
        <radialGradient id="buddy-arm" cx="40%" cy="30%" r="80%">
          <stop offset="0" stop-color="#cfe0ff"></stop>
          <stop offset="1" stop-color="#6f93d8"></stop>
        </radialGradient>
        <radialGradient id="buddy-belly" cx="50%" cy="40%" r="60%">
          <stop offset="0" stop-color="#ffffff" stop-opacity="0.55"></stop>
          <stop offset="1" stop-color="#ffffff" stop-opacity="0"></stop>
        </radialGradient>
        <radialGradient id="buddy-eye" cx="40%" cy="30%" r="75%">
          <stop offset="0" stop-color="#3a4a6b"></stop>
          <stop offset="1" stop-color="#0d1322"></stop>
        </radialGradient>
        <filter id="buddy-soft" x="-50%" y="-50%" width="200%" height="200%">
          <feGaussianBlur stdDeviation="2.2"></feGaussianBlur>
        </filter>
        <filter id="buddy-softer" x="-50%" y="-50%" width="200%" height="200%">
          <feGaussianBlur stdDeviation="3.5"></feGaussianBlur>
        </filter>
      </defs>
      <ellipse class="buddy__shadow" cx="50" cy="94" rx="26" ry="4" filter="url(#buddy-softer)"></ellipse>
      <g class="buddy__figure">
        <ellipse class="buddy__foot" cx="38" cy="89" rx="8" ry="4"></ellipse>
        <ellipse class="buddy__foot" cx="62" cy="89" rx="8" ry="4"></ellipse>
        <path class="buddy__arm buddy__arm--left" d="M18 60c-8 2-12 8-10 12s8 2 12-2"></path>
        <g class="buddy__arm-wrap">
          <path class="buddy__arm buddy__arm--right" d="M82 60c8 2 12 8 10 12s-8 2-12-2"></path>
        </g>
        <path class="buddy__body" d="M14 62C14 30 30 12 50 12s36 18 36 50c0 16-12 28-36 28S14 78 14 62z"></path>
        <ellipse class="buddy__belly" cx="50" cy="72" rx="20" ry="14"></ellipse>
        <path class="buddy__rim" d="M80 50c4 10 4 22-2 30" filter="url(#buddy-soft)"></path>
        <ellipse class="buddy__gloss" cx="34" cy="26" rx="9" ry="5.5" transform="rotate(-28 34 26)" filter="url(#buddy-soft)"></ellipse>
        <circle class="buddy__gloss buddy__gloss--dot" cx="26" cy="36" r="1.8"></circle>
        <ellipse class="buddy__cheek" cx="29" cy="62" rx="6" ry="3.5" filter="url(#buddy-soft)"></ellipse>
        <ellipse class="buddy__cheek" cx="71" cy="62" rx="6" ry="3.5" filter="url(#buddy-soft)"></ellipse>
        <g class="buddy__eyes">
          <g class="buddy__lids">
            <ellipse class="buddy__eye" cx="38" cy="48" rx="5" ry="7"></ellipse>
            <ellipse class="buddy__eye" cx="62" cy="48" rx="5" ry="7"></ellipse>
            <circle class="buddy__shine" cx="40" cy="45.5" r="1.8"></circle>
            <circle class="buddy__shine" cx="64" cy="45.5" r="1.8"></circle>
            <circle class="buddy__shine buddy__shine--small" cx="36.6" cy="51.5" r="0.9"></circle>
            <circle class="buddy__shine buddy__shine--small" cx="60.6" cy="51.5" r="0.9"></circle>
          </g>
        </g>
        <g class="buddy__sleepy">
          <path d="M32 50q6 4 12 0"></path>
          <path d="M56 50q6 4 12 0"></path>
        </g>
        <path class="buddy__mouth buddy__mouth--smile" d="M43 66q7 6 14 0"></path>
        <ellipse class="buddy__mouth buddy__mouth--o" cx="50" cy="68" rx="3.5" ry="4.5"></ellipse>
        <g class="buddy__book">
          <path d="M28 70l22 5 22-5v16l-22 5-22-5z"></path>
          <path class="buddy__book-line" d="M50 75v16"></path>
        </g>
      </g>
      <circle class="buddy__ball" cx="50" cy="4" r="6"></circle>
    </svg>
  </button>
  <button class="buddy__hide" type="button" aria-label="Hide Buddy">×</button>
  </div>
</div>
<button class="buddy-return" type="button" hidden aria-label="Bring Buddy back">
  <svg viewBox="0 0 100 100" aria-hidden="true"><path d="M14 62C14 30 30 12 50 12s36 18 36 50c0 16-12 28-36 28S14 78 14 62z" fill="currentColor"></path></svg>
</button>

<style>
  .buddy {
    --size: 5.5rem;
    position: fixed;
    left: 0;
    bottom: calc(var(--space-4) + env(safe-area-inset-bottom, 0px));
    z-index: 50;
    width: var(--size);
    height: var(--size);
    /* A posição horizontal (--x) é controlada pelo script */
    transform: translateX(var(--x, calc(100vw - var(--size) - var(--space-8))));
    transition: transform var(--walk-dur, 0s) linear;
  }

  .buddy__stage {
    position: relative;
    width: 100%;
    height: 100%;
    transition:
      transform var(--dur-base) var(--ease-settle),
      opacity var(--dur-base) var(--ease-out);
  }

  .buddy.is-hidden .buddy__stage {
    transform: translateY(140%);
    opacity: 0;
    pointer-events: none;
  }

  .buddy__svg {
    transition: transform 0.25s var(--ease-out);
  }

  .buddy.is-facing-left .buddy__svg {
    transform: scaleX(-1);
  }

  .buddy__btn {
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .buddy__btn:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    border-radius: 50%;
  }

  .buddy__svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .buddy__ball,
  .buddy__book {
    opacity: 0;
    transition: opacity 0.2s var(--ease-out);
  }

  .buddy__ball {
    fill: var(--color-text);
    transform-box: view-box;
  }

  .buddy__book path {
    fill: var(--color-surface-2);
    stroke: var(--color-text-2);
    stroke-width: 1.5;
    stroke-linejoin: round;
  }

  .buddy__shadow {
    fill: #000;
    opacity: 0.55;
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 0.3s var(--ease-out);
  }

  .buddy__figure {
    transform-box: fill-box;
    transform-origin: 50% 100%;
    transition: transform 0.4s var(--ease-settle);
  }

  .buddy__body {
    fill: url(#buddy-body);
  }

  .buddy__arm {
    fill: url(#buddy-arm);
  }

  .buddy__foot {
    fill: #6f93d8;
  }

  .buddy__belly {
    fill: url(#buddy-belly);
  }

  /* Luz de recorte do lado da sombra e brilho no topo da cabeça */
  .buddy__rim {
    fill: none;
    stroke: #e6f0ff;
    stroke-width: 2;
    stroke-linecap: round;
    opacity: 0.55;
  }

  .buddy__gloss {
    fill: #fff;
    opacity: 0.85;
  }

  .buddy__gloss--dot {
    opacity: 0.7;
  }

  .buddy__arm-wrap {
    transform-box: view-box;
    transform-origin: 82px 62px;
  }

  .buddy__cheek {
    fill: #ff9db8;
    opacity: 0.55;
  }

  .buddy__eyes {
    transition: transform 0.18s ease-out;
  }

  .buddy__lids {
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 0.25s var(--ease-settle);
  }

  .buddy__eye {
    fill: url(#buddy-eye);
  }

  .buddy__mouth--o {
    fill: #1b2a44;
  }

  .buddy__shine {
    fill: #fff;
  }

  .buddy__shine--small {
    opacity: 0.75;
  }

  .buddy__mouth--smile,
  .buddy__sleepy path {
    fill: none;
    stroke: #1b2a44;
    stroke-width: 3;
    stroke-linecap: round;
  }

  .buddy__sleepy,
  .buddy__mouth--o {
    opacity: 0;
  }

  /* Estados */
  .buddy.is-blinking .buddy__lids {
    transform: scaleY(0.1);
    transition-duration: 0.08s;
  }

  .buddy.is-excited .buddy__lids {
    transform: scale(1.18);
  }

  .buddy.is-excited .buddy__mouth--smile,
  .buddy.is-surprised .buddy__mouth--smile {
    opacity: 0;
  }

  .buddy.is-excited .buddy__mouth--o,
  .buddy.is-surprised .buddy__mouth--o {
    opacity: 1;
  }

  .buddy.is-sleeping .buddy__eyes {
    opacity: 0;
  }

  .buddy.is-sleeping .buddy__sleepy {
    opacity: 1;
  }

  .buddy.is-sleeping .buddy__figure {
    animation: breathe 3s ease-in-out infinite;
  }

  .buddy.is-hopping .buddy__figure {
    animation: hop 0.6s var(--ease-out);
  }

  .buddy.is-hopping .buddy__shadow {
    animation: shadow-hop 0.6s var(--ease-out);
  }

  .buddy.is-bouncing .buddy__figure {
    transform: scale(1.06, 0.94);
  }

  .buddy.is-waving .buddy__arm-wrap {
    animation: wave 0.5s ease-in-out 4;
  }

  .buddy.is-walking .buddy__figure {
    animation: waddle 0.42s ease-in-out infinite;
  }

  .buddy.is-stretching .buddy__figure {
    animation: stretch 1.6s var(--ease-out);
  }

  .buddy.is-stretching .buddy__arm {
    animation: arms-up 1.6s var(--ease-out);
  }

  .buddy.is-yawning .buddy__lids {
    transform: scaleY(0.25);
  }

  .buddy.is-yawning .buddy__mouth--smile {
    opacity: 0;
  }

  .buddy.is-yawning .buddy__mouth--o {
    opacity: 1;
    transform-box: fill-box;
    transform-origin: center;
    animation: yawn 1.8s ease-in-out;
  }

  .buddy.is-juggling .buddy__ball {
    opacity: 1;
    animation: ball 0.9s ease-in-out 3;
  }

  .buddy.is-reading .buddy__book {
    opacity: 1;
  }

  .buddy.is-reading .buddy__figure {
    animation: breathe 3s ease-in-out infinite;
  }

  @keyframes waddle {
    25% {
      transform: translateY(-5%) rotate(-5deg);
    }
    50% {
      transform: translateY(0) rotate(0deg);
    }
    75% {
      transform: translateY(-5%) rotate(5deg);
    }
  }

  @keyframes stretch {
    40%,
    60% {
      transform: scale(0.94, 1.14);
    }
  }

  @keyframes arms-up {
    40%,
    60% {
      transform: translateY(-14px);
    }
  }

  @keyframes yawn {
    40%,
    70% {
      transform: scale(1.5, 1.9);
    }
  }

  @keyframes ball {
    0%,
    100% {
      transform: translateY(14px);
    }
    50% {
      transform: translateY(-26px);
    }
  }

  @keyframes hop {
    40% {
      transform: translateY(-28%) scale(0.95, 1.05);
    }
    70% {
      transform: translateY(0) scale(1.08, 0.92);
    }
  }

  @keyframes shadow-hop {
    40% {
      transform: scale(0.6);
    }
  }

  @keyframes breathe {
    50% {
      transform: scale(1.03, 0.97);
    }
  }

  @keyframes wave {
    50% {
      transform: rotate(-38deg);
    }
  }

  /* Balão de fala */
  .buddy__bubble {
    position: absolute;
    right: 30%;
    bottom: calc(100% + var(--space-2));
    width: max-content;
    max-width: min(15rem, 70vw);
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-line-strong);
    border-radius: 14px 14px 4px 14px;
    background: var(--color-surface-2);
    color: var(--color-text);
    font-size: var(--text-sm);
    line-height: 1.35;
    opacity: 0;
    transform: translateY(0.5rem) scale(0.95);
    transform-origin: 100% 100%;
    pointer-events: none;
    transition:
      opacity var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }

  .buddy.is-left .buddy__bubble {
    right: auto;
    left: 30%;
    border-radius: 14px 14px 14px 4px;
    transform-origin: 0 100%;
  }

  .buddy__bubble.is-visible {
    opacity: 1;
    transform: none;
  }

  .buddy__hide {
    position: absolute;
    top: -0.25rem;
    right: -0.25rem;
    width: 1.5rem;
    height: 1.5rem;
    display: grid;
    place-items: center;
    padding: 0;
    border: 1px solid var(--color-line-strong);
    border-radius: 50%;
    background: var(--color-surface-2);
    color: var(--color-text-2);
    font-size: 0.9rem;
    line-height: 1;
    cursor: pointer;
    opacity: 0;
    transition: opacity var(--dur-fast) var(--ease-out);
  }

  .buddy:hover .buddy__hide,
  .buddy__hide:focus-visible {
    opacity: 1;
  }

  .buddy-return {
    position: fixed;
    right: calc(var(--space-6) + env(safe-area-inset-right, 0px));
    bottom: 0;
    z-index: 50;
    width: 2.75rem;
    height: 1.5rem;
    padding: 0.35rem 0.6rem 0;
    border: 1px solid var(--color-line-strong);
    border-bottom: 0;
    border-radius: 12px 12px 0 0;
    background: var(--color-surface-2);
    color: var(--color-accent);
    cursor: pointer;
    padding-bottom: env(safe-area-inset-bottom, 0px);
    box-sizing: content-box;
  }

  .buddy-return svg {
    width: 100%;
    height: 100%;
  }

  @media (hover: none) {
    .buddy__hide {
      opacity: 0.8;
    }
  }

  @media (max-width: 40rem) {
    .buddy {
      --size: 4.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .buddy *,
    .buddy {
      animation: none !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>

<script>
  import '../../scripts/buddy';
</script>
