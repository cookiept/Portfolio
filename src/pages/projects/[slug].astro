---
// Página de cada projeto. Com `blocks` no ficheiro do projeto mostra o
// case study completo; sem isso mostra só o resumo.
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import '@fontsource/inter/100.css';
import '@fontsource/eb-garamond/400-italic.css';
import '@fontsource/space-grotesk/300.css';
import BaseLayout from '@layouts/BaseLayout.astro';
import Nav from '@components/ui/Nav.astro';
import Footer from '@components/ui/Footer.astro';
import { site } from '@data/site';
import { withBase } from '../../utils/url';

export async function getStaticPaths() {
  const projects = (await getCollection('projects', ({ data }) => !data.placeholder)).sort(
    (a, b) => a.data.order - b.data.order,
  );
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

const { project, next } = Astro.props;
// O poster fica só no cartão da página inicial, não se repete aqui
const { title, summary, facts, blocks } = project.data;
const { Content } = await render(project);
const shotWidths = [600, 1000, 1512];
---

<BaseLayout title={`${title}, ${site.name}`} description={summary}>
  <Nav />
  <main class="case" id="top">
    <header class="case__hero container">
      <a class="case__back" href={withBase('/#work')}>← All work</a>
      <h1 class="case__title">{title}</h1>
      <p class="case__summary">{summary}</p>
      {
        facts && (
          <dl class="case__facts">
            {facts.map((f) => (
              <div>
                <dt>{f.label}</dt>
                <dd>{f.value}</dd>
              </div>
            ))}
          </dl>
        )
      }
    </header>

    {
      blocks ? (
        <div class="case__blocks container">
          {blocks.map((b) => {
            if (b.type === 'text')
              return (
                <section class="b-text" data-reveal>
                  <div>
                    {b.eyebrow && <p class="eyebrow">{b.eyebrow}</p>}
                    <h2>{b.title}</h2>
                  </div>
                  <div class="b-text__body">
                    {b.body.map((p) => (
                      <p>{p}</p>
                    ))}
                  </div>
                </section>
              );
            if (b.type === 'figure')
              return (
                <figure class="b-figure" data-reveal>
                  <Image src={b.image.src} alt={b.image.alt} widths={shotWidths} quality={90} sizes="(max-width: 80rem) 100vw, 80rem" />
                  {b.caption && <figcaption>{b.caption}</figcaption>}
                </figure>
              );
            if (b.type === 'grid')
              return (
                <figure class="b-grid" data-reveal>
                  <div class="b-grid__items" style={`--cols:${b.columns}`}>
                    {b.images.map((s) => (
                      <div class="shot">
                        <Image src={s.src} alt={s.alt} widths={shotWidths} quality={90} sizes={`(max-width: 48rem) 100vw, ${Math.round(80 / b.columns)}rem`} />
                        {s.label && <span class="shot__label">{s.label}</span>}
                      </div>
                    ))}
                  </div>
                  {b.caption && <figcaption>{b.caption}</figcaption>}
                </figure>
              );
            if (b.type === 'tall')
              return (
                <figure class="b-tall" data-reveal>
                  <div class="b-tall__items">
                    {b.images.map((s) => (
                      <div class="shot">
                        <Image src={s.src} alt={s.alt} widths={[400, 800, 1512]} quality={90} sizes="(max-width: 48rem) 75vw, 20rem" />
                        {s.label && <span class="shot__name">{s.label}</span>}
                      </div>
                    ))}
                  </div>
                  {b.caption && <figcaption>{b.caption}</figcaption>}
                </figure>
              );
            if (b.type === 'steps')
              return (
                <section class="b-steps" data-reveal>
                  <h2>{b.title}</h2>
                  <ol>
                    {b.steps.map((s) => (
                      <li>
                        <h3>{s.title}</h3>
                        <p>{s.text}</p>
                      </li>
                    ))}
                  </ol>
                </section>
              );
            if (b.type === 'system')
              return (
                <section class="b-system" data-reveal>
                  <h2>{b.title}</h2>
                  <ul class="b-system__colors">
                    {b.colors.map((c) => (
                      <li>
                        <span class="swatch" style={`background:${c.hex}`} />
                        <strong>{c.name}</strong>
                        <code>{c.hex}</code>
                      </li>
                    ))}
                  </ul>
                  <ul class="b-system__fonts">
                    {b.fonts.map((f) => (
                      <li>
                        <p class="specimen" style={`font-family:'${f.family}';font-weight:${f.weight};font-style:${f.italic ? 'italic' : 'normal'}`}>
                          {f.sample}
                        </p>
                        <strong>{f.name}</strong>
                        <span>{f.role}</span>
                      </li>
                    ))}
                  </ul>
                </section>
              );
          })}
        </div>
      ) : (
        <div class="case__body container">
          <Content />
          <p class="case__soon">The full case study is coming soon.</p>
        </div>
      )
    }

    {
      next && next.id !== project.id && (
        <nav class="case__next container" aria-label="Next project">
          <a href={withBase(`/projects/${next.id}/`)}>
            <span class="eyebrow">Next project</span>
            <span class="case__next-title">{next.data.title} →</span>
          </a>
        </nav>
      )
    }
  </main>
  <Footer />
</BaseLayout>

<style>
  .case {
    padding-block: var(--space-32) var(--space-24);
    display: grid;
    gap: var(--space-12);
  }

  .case__hero {
    display: grid;
    gap: var(--space-6);
  }

  .case__back {
    color: var(--color-text-2);
    text-decoration: none;
  }

  .case__back:hover {
    color: var(--color-text);
  }

  .case__title {
    font-size: var(--text-hero);
    line-height: 1;
  }

  .case__summary {
    max-width: 40ch;
    font-size: var(--text-lg);
    color: var(--color-text-2);
  }

  .case__facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: var(--space-6);
    margin: var(--space-4) 0 0;
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-line);
  }

  .case__facts dt {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .case__facts dd {
    margin: var(--space-1) 0 0;
  }

  .case__blocks {
    display: grid;
    gap: var(--space-24);
    margin-top: var(--space-12);
  }

  .eyebrow {
    font-size: var(--text-sm);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: var(--space-3);
  }

  h2 {
    font-size: var(--text-h2);
    line-height: 1.05;
  }

  /* Texto: título à esquerda, parágrafos à direita */
  .b-text {
    display: grid;
    gap: var(--space-6);
  }

  .b-text__body {
    display: grid;
    gap: var(--space-4);
    max-width: 58ch;
    font-size: var(--text-lg);
    color: var(--color-text-2);
  }

  @media (min-width: 56rem) {
    .b-text {
      grid-template-columns: 5fr 6fr;
      gap: var(--space-16);
    }
  }

  figure {
    margin: 0;
    display: grid;
    gap: var(--space-4);
  }

  figcaption {
    max-width: 60ch;
    color: var(--color-text-2);
  }

  figure :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-media);
    border: 1px solid var(--color-line);
  }

  .shot {
    position: relative;
  }

  .shot__label {
    position: absolute;
    left: var(--space-3);
    top: var(--space-3);
    padding: var(--space-1) var(--space-3);
    border-radius: 999px;
    font-size: var(--text-sm);
    background: rgb(10 11 15 / 0.6);
    backdrop-filter: blur(6px);
  }

  .b-grid__items {
    display: grid;
    gap: var(--space-4);
  }

  @media (min-width: 48rem) {
    .b-grid__items {
      grid-template-columns: repeat(var(--cols), 1fr);
    }
  }

  /* Páginas compridas: lado a lado, scroll horizontal no telemóvel */
  .b-tall__items {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 75%;
    gap: var(--space-4);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: var(--space-2);
  }

  .b-tall .shot {
    scroll-snap-align: start;
    display: grid;
    gap: var(--space-3);
    align-content: start;
  }

  .b-tall :global(img) {
    aspect-ratio: 1512 / 3334;
    object-fit: cover;
    object-position: top;
  }

  .shot__name {
    font-family: 'EB Garamond', serif;
    font-style: italic;
    font-size: var(--text-title);
  }

  @media (min-width: 48rem) {
    .b-tall__items {
      grid-auto-flow: row;
      grid-template-columns: repeat(4, 1fr);
      overflow: visible;
    }
  }

  .b-steps {
    display: grid;
    gap: var(--space-8);
  }

  .b-steps ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-6);
    counter-reset: step;
  }

  @media (min-width: 48rem) {
    .b-steps ol {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .b-steps li {
    counter-increment: step;
    display: grid;
    gap: var(--space-2);
    align-content: start;
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-line-strong);
  }

  .b-steps li::before {
    content: '0' counter(step);
    color: var(--color-accent);
    font-size: var(--text-sm);
  }

  .b-steps h3 {
    font-size: var(--text-title);
  }

  .b-steps p {
    color: var(--color-text-2);
  }

  .b-system {
    display: grid;
    gap: var(--space-8);
  }

  .b-system ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
  }

  .b-system__colors {
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
  }

  .b-system__colors li {
    display: grid;
    gap: var(--space-1);
  }

  .swatch {
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-media);
    border: 1px solid var(--color-line-strong);
    margin-bottom: var(--space-2);
  }

  .b-system code {
    color: var(--color-text-2);
    font-size: var(--text-sm);
  }

  .b-system__fonts {
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
  }

  .b-system__fonts li {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-6);
    border-radius: var(--radius-media);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
  }

  .specimen {
    font-size: clamp(1.75rem, 1.4rem + 1.2vw, 2.4rem);
    line-height: 1.15;
    margin-bottom: var(--space-4);
  }

  .b-system__fonts span {
    color: var(--color-text-2);
    font-size: var(--text-sm);
  }

  .case__body {
    display: grid;
    gap: var(--space-4);
    max-width: 62ch;
    margin-top: var(--space-8);
    color: var(--color-text-2);
  }

  .case__soon {
    color: var(--color-accent);
  }

  .case__next a {
    display: grid;
    gap: var(--space-2);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-line);
    text-decoration: none;
    color: var(--color-text);
  }

  .case__next-title {
    font-family: var(--font-display);
    font-size: var(--text-h2);
    line-height: 1.05;
  }

  .case__next a:hover .case__next-title {
    color: var(--color-accent);
  }
</style>
